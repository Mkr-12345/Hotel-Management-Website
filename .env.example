# Copy this file to .env and fill in the values.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For deployment, e.g. https://mkrhotels.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys first.
# Leave empty to use demo payments while developing (DEBUG must be True).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add <your-site>/payments/razorpay/webhook/ with event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Email. Leave EMAIL_HOST empty to print emails in the terminal instead.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=your gmail, EMAIL_HOST_PASSWORD=an App Password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MKR Hotels <no-reply@mkrhotels.local>
HOTEL_CONTACT_EMAIL=contactMKRhotels@gmail.com

# Minutes an unpaid booking holds its room
BOOKING_HOLD_MINUTES=15
